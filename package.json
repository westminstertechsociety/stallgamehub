{
  "name": "stallgamehub",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Offline game hub for the Tech Society stall: one host laptop, a projector, two player laptops, a phone for the operator.",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "tsx watch --clear-screen=false --ignore 'app/**' --ignore 'components/**' --ignore '.next/**' --ignore 'data/**' --ignore 'public/**' server/index.ts",
    "build": "next build && node scripts/check-bundle.mjs",
    "start": "node scripts/start.mjs",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test \"tests/**/*.test.ts\"",
    "format": "prettier --write .",
    "fonts": "node scripts/vendor-fonts.mjs"
  },
  "dependencies": {
    "@fontsource-variable/archivo": "5.3.0",
    "next": "16.3.5",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "socket.io": "4.8.3",
    "socket.io-client": "4.8.3",
    "tsx": "4.23.13",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "24.13.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.5",
    "eslint-config-prettier": "10.1.8",
    "prettier": "3.9.6",
    "typescript": "5.9.3"
  }
}
